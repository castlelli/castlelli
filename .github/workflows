name: Metrics
on:
  schedule: [{ cron: '0 0 * * *' }] # Atualiza todo dia à meia-noite
  workflow_dispatch:
jobs:
  github-metrics:
    runs-on: ubuntu-latest
    steps:
      - uses: lowlighter/metrics@latest
        with:
          token: ${{ secrets.METRICS_TOKEN }}
          user: castlelli
          template: classic
          base: header, activity, community, repositories, metadata
          plugin_lines: yes # Para mostrar "Lines of code changed"
          plugin_followup: yes # Para mostrar "Repositories with contributions"
          plugin_isocalendar: yes
