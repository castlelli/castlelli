name: Metrics
on:
  schedule: [{cron: "0 0 * * *"}] # Atualiza todo dia
  workflow_dispatch: # Permite rodar manualmente
jobs:
  github-metrics:
    runs-on: ubuntu-latest
    steps:
      - uses: lowlighter/metrics@latest
        with:
          token: ${{ secrets.METRICS_TOKEN }}
          user: castlelli
          template: classic
          base: header, activity, community, repositories, metadata
          base_indepth: yes # Para estatísticas detalhadas
          plugin_lines: yes # Exibe "Lines of code changed"
          plugin_followup: yes # Exibe "Repositories with contributions"
